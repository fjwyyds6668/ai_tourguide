# 数据库配置
DATABASE_URL="postgresql://postgres:1234@localhost:5432/ai_tourguide"
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_tourguide
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456

# 图数据库配置
NEO4J_URI=bolt://localhost:30001
NEO4J_USER=neo4j
NEO4J_PASSWORD=12345678

# 向量数据库配置
MILVUS_HOST=localhost
MILVUS_PORT=30002

# 硅基流动配置
OPENAI_API_KEY=sk-uzyngtfqhclwhcpdwplvmcliwikccwzvsmbgosktusxzdnwy
OPENAI_API_BASE=https://api.siliconflow.cn/v1/
OPENAI_MODEL=Qwen/Qwen3-Next-80B-A3B-Instruct

PYTHONIOENCODING=utf-8
PYTHONUTF8=1

PADDLESPEECH_PYTHON=python
PADDLESPEECH_DEFAULT_VOICE=fastspeech2_csmsc
PADDLESPEECH_VOICES_JSON={"fastspeech2_csmsc":{"am":"fastspeech2_csmsc","voc":"pwgan_csmsc","lang":"zh"}}

# 是否自动更新 GraphRAG（默认：true）
AUTO_UPDATE_GRAPH_RAG=true

# GraphRAG 集合名称（默认：tour_knowledge）
GRAPHRAG_COLLECTION_NAME=tour_knowledge

# ===== 科大讯飞 TTS =====
XFYUN_APPID=21004c61
XFYUN_API_KEY=bb36163307001ec8146fa40492c6c190
XFYUN_API_SECRET=Nzk2NmFiMWQyZjZiYTY4MmYyOGNjNjQ5
# 默认音色（vcn，可选：x4_xiaoyan / x4_yezi / aisjiuxu / aisjinger / aisbabyxu）
XFYUN_VOICE=x4_yezi

# ===== 游客端扫码入口（可选）=====
# 管理端「游客端入口」页展示的二维码将指向此地址，手机扫码即可打开游客端
# 本地开发示例：将 192.168.x.x 改为本机局域网 IP，手机与电脑需在同一 WiFi
# TOURIST_APP_URL=http://192.168.1.100:5173

# ===== 会话持久化（可选）=====
# 配置后会话存入 Redis，多进程/重启不丢；不配置则使用内存
# REDIS_URL=redis://localhost:6379/0